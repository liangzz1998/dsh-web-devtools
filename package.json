{
  "name": "dsh-web-devtools",
  "version": "0.3.0",
  "description": "把网页 F12 开发者工具接给 DeepSeek Harness 的 agent：既能读插件拉起的专用浏览器，也能通过浏览器扩展直接读你当前正在浏览的标签页（chrome.debugger = F12 同款 CDP）。页面概览、元素定位器、操作时间线、登录态、网络、控制台、下载。零依赖。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "devtools",
    "cdp",
    "chrome-devtools-protocol",
    "console",
    "dom",
    "f12",
    "web-debugging"
  ],
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liangzz1998/dsh-web-devtools.git"
  },
  "homepage": "https://github.com/liangzz1998/dsh-web-devtools",
  "bugs": {
    "url": "https://github.com/liangzz1998/dsh-web-devtools/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "tools",
    "extension",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node tests/e2e.mjs",
    "test:live": "node tests/extension-e2e.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
