{
  "manifest_version": 3,
  "name": "DSH Web DevTools Bridge",
  "version": "0.3.0",
  "description": "把当前标签页的开发者工具（控制台 / DOM / 网络）桥接给 DeepSeek Harness，不用另开专用浏览器。",
  "permissions": ["debugger", "tabs", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DSH Web DevTools Bridge"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
